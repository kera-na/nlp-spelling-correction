# DICTIONARY MANAGER


class DictionaryManager:
    def __init__(self, vocab_path: str = "vocabulary.txt") -> None:
        with open(vocab_path, "r", encoding="utf-8") as f:
            self.words = sorted(w.strip() for w in f if w.strip())
        self.word_set = set(self.words)

    def is_word_valid(self, word: str) -> bool:
        return word.lower() in self.word_set

    def get_matches(self, query: str, mode: str = "prefix", limit: int = 50) -> list:
        if not query:
            return self.words[:limit]
